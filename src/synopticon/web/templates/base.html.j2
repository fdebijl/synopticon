<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · Synopticon</title>
<script>
  /* No-flash theme: apply the stored preference before first paint. */
  (function () {
    var t = localStorage.getItem("syn-theme");
    if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
  })();
</script>
<link rel="stylesheet" href="/static/css/app.css?v={{ version }}">
{% include "partials/favicons.html.j2" %}
{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="layout">
  {% include "partials/sidebar.html.j2" %}
  <div class="content">
    <header class="topbar" role="banner">
      <button class="icon-btn nav-toggle" type="button" aria-label="Toggle navigation" onclick="document.body.classList.toggle('nav-open')">&#9776;</button>
      <h1 class="topbar-title">{{ title }}</h1>
      <div class="topbar-spacer"></div>
      <a class="job-indicator{% if not running_job %} hidden{% endif %}" id="global-job-indicator"
         href="{% if running_job %}/jobs/{{ running_job.id }}{% else %}#{% endif %}"
         aria-live="polite">
        <span class="spinner" aria-hidden="true"></span>
        <span id="global-job-label">{% if running_job %}{{ running_job.name }} running{% endif %}</span>
      </a>
      <div class="menu" id="theme-menu">
        <button class="icon-btn" type="button" aria-haspopup="true" aria-expanded="false"
                onclick="Syn.toggleMenu('theme-menu')" title="Theme" aria-label="Theme">&#9681;</button>
        <div class="menu-panel" role="menu">
          <button role="menuitemradio" onclick="Syn.setTheme('auto')">Auto</button>
          <button role="menuitemradio" onclick="Syn.setTheme('light')">Light</button>
          <button role="menuitemradio" onclick="Syn.setTheme('dark')">Dark</button>
        </div>
      </div>
      <div class="menu" id="user-menu">
        <button class="icon-btn" type="button" aria-haspopup="true" aria-expanded="false"
                onclick="Syn.toggleMenu('user-menu')" aria-label="Account menu">
          {{ (username or "?")[0]|upper }}
        </button>
        <div class="menu-panel" role="menu">
          <div class="menu-label">{{ username or "not signed in" }}</div>
          <a role="menuitem" href="/settings">Settings</a>
          <form method="post" action="/logout">
            <button type="submit" role="menuitem">Sign out</button>
          </form>
        </div>
      </div>
    </header>
    <main id="main" class="main" role="main" tabindex="-1">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
{% include "partials/confirm_modal.html.j2" %}
<div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="false"></div>
<script src="/static/js/lib.js?v={{ version }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
