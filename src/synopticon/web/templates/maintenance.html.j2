{% extends "base.html.j2" %}
{% from "partials/job_panel.html.j2" import job_panel %}
{% block head %}
<style>
  .maint-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--sp-3); }
  .maint-card { display: flex; flex-direction: column; gap: var(--sp-2); }
  .maint-card h3 { margin: 0; }
  .maint-card.danger-card { border-color: var(--danger); box-shadow: 0 0 0 1px var(--danger) inset; }
  .maint-count { font-variant-numeric: tabular-nums; font-weight: 600; }
  .maint-opts { display: flex; flex-direction: column; gap: var(--sp-1); }
  .maint-opts .opt-row { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; }
  .maint-opts label { font-size: var(--fs-sm); }
  .maint-actions { display: flex; gap: var(--sp-2); margin-top: auto; padding-top: var(--sp-2); }
</style>
{% endblock %}
{% block content %}
<div class="page">
  {{ job_panel() }}

  <div class="maint-grid" style="margin-top: var(--sp-4)">

    {# ---- dedupe ---- #}
    <section class="card maint-card" data-cmd="dedupe">
      <h3>Deduplicate photos</h3>
      <p class="muted">Delete duplicate photos from the NAS using stored hashes. Dry run is free; applying deletes on the NAS.</p>
      <div class="maint-opts">
        <label class="opt-check"><input type="checkbox" id="dd-exact" checked> exact (sha256 identical)</label>
        <label class="opt-check"><input type="checkbox" id="dd-visual"> visual (pHash near-duplicates)</label>
        <div class="opt-row"><label for="dd-threshold">Hamming threshold</label>
          <input class="input input-sm" id="dd-threshold" type="number" min="0" max="64" placeholder="default"></div>
      </div>
      <div class="maint-actions">
        <button type="button" class="btn" id="dd-preview">Dry run</button>
        <button type="button" class="btn btn-danger" id="dd-apply">Delete duplicates…</button>
      </div>
    </section>

    {# ---- clear-queue ---- #}
    <section class="card maint-card" data-cmd="clear-queue">
      <h3>Clear review queue</h3>
      <p class="muted">Remove pending review items. Approved/applied decisions are unaffected.</p>
      <p>Pending items: <span class="maint-count" id="mc-pending">—</span></p>
      <div class="maint-actions">
        <button type="button" class="btn btn-danger" id="cq-run">Clear queue…</button>
      </div>
    </section>

    {# ---- delete-crops ---- #}
    <section class="card maint-card" data-cmd="delete-crops">
      <h3>Delete crop images</h3>
      <p class="muted">Wipe cached face crops to reclaim disk. They rebuild on demand via regen-crops.</p>
      <p>On disk: <span class="maint-count" id="mc-crops">—</span></p>
      <div class="maint-actions">
        <button type="button" class="btn btn-danger" id="crops-run">Delete crops…</button>
      </div>
    </section>

    {# ---- reset ---- #}
    <section class="card maint-card danger-card" data-cmd="reset">
      <h3>Reset local database</h3>
      <p class="muted">Drop pipeline data from the local DB. This does not touch the NAS.</p>
      <p>
        Faces: <span class="maint-count" id="mc-faces">—</span> ·
        Embeddings: <span class="maint-count" id="mc-embeddings">—</span> ·
        Cluster runs: <span class="maint-count" id="mc-runs">—</span> ·
        Photos: <span class="maint-count" id="mc-photos">—</span>
      </p>
      <div class="maint-opts">
        <label class="opt-check"><input type="checkbox" id="rs-all"> reset EVERYTHING (--all, includes synced photos)</label>
        <label class="opt-check"><input type="checkbox" id="rs-keep-crops"> keep crop images (--keep-crops)</label>
      </div>
      <div class="maint-actions">
        <button type="button" class="btn btn-danger" id="rs-run">Reset…</button>
      </div>
    </section>

  </div>
</div>
{% endblock %}
{% block scripts %}
<script src="/static/js/job-panel.js?v={{ version }}"></script>
<script src="/static/js/maintenance.js?v={{ version }}"></script>
{% endblock %}
