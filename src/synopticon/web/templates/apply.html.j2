{% extends "base.html.j2" %}
{% from "partials/job_panel.html.j2" import job_panel %}
{% block head %}
<style>
  .kinds { display: flex; flex-direction: column; gap: var(--sp-1); margin: var(--sp-2) 0; }
  .kind-row { display: flex; align-items: center; gap: var(--sp-2); }
  .kind-row label { display: inline-flex; align-items: center; gap: var(--sp-2); flex: 1; }
  .kind-count { font-size: var(--fs-sm); }
  .kind-danger { color: var(--danger); font-weight: 600; }
  .scope-row { display: flex; gap: var(--sp-3); align-items: center; flex-wrap: wrap; margin: var(--sp-2) 0; }
  .scope-row label { font-size: var(--fs-sm); color: var(--text-2); }
  .consent-box { border: 1px solid var(--warn); background: rgba(224, 133, 15, .08); border-radius: var(--radius); padding: var(--sp-2) var(--sp-3); margin-top: var(--sp-2); }
  .consent-box.hidden { display: none; }
  .consent-box label { display: flex; align-items: center; gap: var(--sp-2); font-size: var(--fs-base); }
  .apply-actions { display: flex; gap: var(--sp-2); margin-top: var(--sp-3); }
  .result-stats { margin-top: var(--sp-3); }
  .result-stats dl { display: grid; grid-template-columns: auto 1fr; gap: 2px var(--sp-3); margin: 0; }
  .result-stats dt { color: var(--text-2); font-size: var(--fs-sm); }
  .result-stats dd { margin: 0; font-variant-numeric: tabular-nums; }
  .named-list { list-style: none; margin: var(--sp-2) 0; padding: 0; max-height: 220px; overflow: auto; }
  .named-list li { padding: var(--sp-1) 0; border-bottom: 1px solid var(--border-soft); }
  .named-list .arrow { opacity: .6; margin: 0 var(--sp-1); }
  .audit-ok { color: var(--ok); }
  .audit-fail { color: var(--danger); }
</style>
{% endblock %}
{% block content %}
{% set spaces = [('', 'both (default)'), ('personal', 'personal'), ('shared', 'shared')] %}
<div class="page">
  <div class="card">
    <h2>Apply corrections</h2>
    <p class="muted">Preview is a free dry run. Applying to the NAS is gated per correction kind; merges are irreversible.</p>

    <h3 style="margin-top: var(--sp-3)">Kinds</h3>
    <div class="kinds" id="apply-kinds">
      {% for k, label, danger in [
        ('assign', 'assign — routine label assignments', false),
        ('low_confidence', 'low_confidence — low-confidence assignments', false),
        ('new_person', 'new_person — create new persons', false),
        ('reassign', 'reassign — move a face to another person', false),
        ('merge', 'merge — join clusters (irreversible)', true),
        ('merge_named', 'merge_named — join two NAMED people (destroys a label)', true),
      ] %}
      <div class="kind-row">
        <label{% if danger %} class="kind-danger"{% endif %}>
          <input type="checkbox" data-kind="{{ k }}"> {{ label }}
        </label>
        <span class="kind-count badge" data-kind-count="{{ k }}">0 approved</span>
      </div>
      {% endfor %}
    </div>

    <div class="scope-row">
      <span><label for="apply-space">Space</label>
        <select class="select" id="apply-space">
          {% for v, l in spaces %}<option value="{{ v }}">{{ l }}</option>{% endfor %}
        </select></span>
      <span><label for="apply-person">Person id</label>
        <input class="input input-sm" id="apply-person" type="number" min="1" placeholder="all"></span>
    </div>

    <div class="consent-box hidden" id="consent-reassign">
      <label><input type="checkbox" id="ack-reassign"> I understand this moves face labels a human can see in Photos (reassign).</label>
    </div>
    <div class="consent-box hidden" id="consent-merge">
      <label><input type="checkbox" id="ack-merge"> I understand merges are irreversible (merge).</label>
    </div>

    <div class="apply-actions">
      <button type="button" class="btn" id="btn-preview">Preview (dry run)</button>
      <button type="button" class="btn btn-danger" id="btn-apply" disabled>Apply to NAS</button>
    </div>
    <p class="muted" id="apply-hint">Run a preview for the selected kinds to enable Apply.</p>
  </div>

  {{ job_panel() }}

  <div class="card result-stats hidden" id="result-card">
    <h3>Last result</h3>
    <dl id="result-stats"></dl>
  </div>

  <div class="card hidden" id="audit-card" style="margin-top: var(--sp-4)">
    <h3>Applied to NAS</h3>
    <table class="data">
      <thead><tr><th></th><th>Action</th><th>Details</th></tr></thead>
      <tbody id="audit-tail"></tbody>
    </table>
  </div>
</div>

<dialog id="merge-named-dialog" class="modal" aria-labelledby="mnd-title">
  <form method="dialog" class="modal-body">
    <div class="danger-banner">Destructive: merging two named people</div>
    <h2 id="mnd-title" class="modal-title">Confirm named ↔ named merges</h2>
    <p class="modal-message">The following already-named people will be merged, permanently destroying one human label per pair:</p>
    <ul class="named-list" id="mnd-list"></ul>
    <div class="modal-phrase">
      <label for="mnd-input" id="mnd-label">Type the confirmation phrase to enable Apply</label>
      <input type="text" id="mnd-input" autocomplete="off" spellcheck="false">
    </div>
    <div class="modal-actions">
      <button type="submit" value="cancel" class="btn btn-ghost" id="mnd-cancel">Cancel</button>
      <button type="submit" value="ok" class="btn btn-danger" id="mnd-ok" disabled>Apply named merges</button>
    </div>
  </form>
</dialog>
{% endblock %}
{% block scripts %}
<script src="/static/js/job-panel.js?v={{ version }}"></script>
<script src="/static/js/apply.js?v={{ version }}"></script>
{% endblock %}
