{% extends "base.html.j2" %}
{% from "partials/job_panel.html.j2" import job_panel %}
{% block content %}
<div class="page">
  <div class="card">
    <h2>Job <span class="mono" id="job-id-label">{{ "#" ~ job_id if job_id.isdigit() else job_id }}</span></h2>
    <p class="muted" id="job-meta"></p>
  </div>
  {{ job_panel() }}
</div>
{% endblock %}
{% block scripts %}
<script src="/static/js/job-panel.js?v={{ version }}"></script>
<script>
  window.addEventListener("DOMContentLoaded", function () {
    var el = document.getElementById("job-panel");
    var panel = new JobPanel(el);
    panel.attach({{ job_id | tojson }});
    Syn.fetchJSON("/api/jobs/" + {{ job_id | tojson }}).then(function (m) {
      var meta = document.getElementById("job-meta");
      if (meta) meta.textContent = m.name + " · " + (m.argv || []).join(" ");
    }).catch(function () {});
  });
</script>
{% endblock %}
