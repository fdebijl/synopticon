<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in · Synopticon</title>
<script>
  (function () {
    var t = localStorage.getItem("syn-theme");
    if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
  })();
</script>
<link rel="stylesheet" href="/static/css/app.css?v={{ version }}">
{% include "partials/favicons.html.j2" %}
</head>
<body class="auth-body">
<main class="auth-card" role="main">
  <div class="brand brand-lg">
    <img class="brand-mark" src="/static/img/logo.svg" alt="" aria-hidden="true">
    <span class="brand-name">Synopticon</span>
  </div>
  <h1 class="auth-title">Sign in</h1>
  {% if error %}<p class="auth-error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/login" class="auth-form">
    <input type="hidden" name="next" value="{{ next }}">
    <label for="username">Username</label>
    <input id="username" name="username" autocomplete="username" required autofocus>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <button type="submit" class="btn btn-action btn-block">Sign in</button>
  </form>
</main>
</body>
</html>
