{% extends "base.html.j2" %}
{% from "partials/review_card.html.j2" import review_card %}
{% block content %}
<div class="page review-page{% if view == 'focus' %} view-focus{% endif %}" id="review-page">
  <div class="toolbar review-toolbar" role="region" aria-label="Review controls">
    <form method="get" class="filters" id="review-filters">
      <label class="sr-only" for="f-kind">Kind</label>
      <select name="kind" id="f-kind" class="select">
        {% for k in ['', 'assign', 'low_confidence', 'reassign', 'merge', 'merge_named', 'new_person'] %}
        <option value="{{ k }}" {% if k == kind %}selected{% endif %}>{{ k or 'all kinds' }}</option>
        {% endfor %}
      </select>
      <label class="sr-only" for="f-status">Status</label>
      <select name="status" id="f-status" class="select">
        {% for s in ['pending', 'approved', 'rejected', 'applied', 'failed'] %}
        <option value="{{ s }}" {% if s == status %}selected{% endif %}>{{ s }}</option>
        {% endfor %}
      </select>
      <input type="hidden" name="view" id="f-view" value="{{ view }}">
      <button type="submit" class="btn btn-sm">Filter</button>
    </form>
    <div class="seg" role="group" aria-label="Review layout">
      <button type="button" class="seg-btn" data-view="grid" aria-pressed="{{ 'true' if view != 'focus' else 'false' }}">Grid</button>
      <button type="button" class="seg-btn" data-view="focus" aria-pressed="{{ 'true' if view == 'focus' else 'false' }}">Focus</button>
    </div>
    <div class="toolbar-spacer"></div>
    <span class="loaded-count" id="loaded-count" aria-live="polite">
      {{ items|length }} of {{ total }} loaded
    </span>
    <div class="bulk">
      <input id="bulk-conf" class="input input-sm" type="number" step="0.01" value="0.55"
             aria-label="Minimum confidence for bulk approve">
      <button class="btn btn-sm" id="bulk-approve">Approve all {{ kind or 'assign' }} &ge; conf</button>
    </div>
    <button class="btn btn-sm btn-ghost" id="undo-btn" disabled title="Nothing to undo">Undo <kbd>u</kbd></button>
    <button class="btn btn-sm btn-ghost" id="shortcut-legend-btn" aria-haspopup="dialog">Shortcuts</button>
  </div>

  <label class="check muted">
    <input type="checkbox" id="hide-unnamed"> hide reassigns to unnamed
  </label>
  <label class="check muted">
    <input type="checkbox" id="hide-unnamed-merges"> hide merges between unnamed
  </label>

  <div class="focus-view" id="focus-view">
    <div class="focus-current" id="focus-current" aria-live="polite"></div>
    <p class="muted focus-empty" id="focus-empty" hidden></p>
    <div class="carousel" id="carousel" aria-label="Review queue"></div>
  </div>

  <div class="grid review-grid" id="grid">
    {% for it in items %}{{ review_card(it) }}{% endfor %}
  </div>
  <div id="scroll-sentinel" class="scroll-sentinel" aria-hidden="true"></div>
  <p class="muted end-note" id="end-note" hidden>End of queue.</p>
</div>

<div class="popover" id="shortcut-legend" role="dialog" aria-label="Keyboard shortcuts" hidden>
  <h3>Keyboard shortcuts</h3>
  <ul>
    <li><kbd>y</kbd> approve · <kbd>n</kbd> reject · <kbd>s</kbd> skip</li>
    <li><kbd>j</kbd> next card · <kbd>k</kbd> previous card</li>
    <li><kbd>&larr;</kbd> previous · <kbd>&rarr;</kbd> next (focus view)</li>
    <li><kbd>u</kbd> undo last decision (this session)</li>
  </ul>
  <button class="btn btn-sm" id="shortcut-legend-close">Close</button>
</div>
{% endblock %}
{% block scripts %}
<script>
  window.SYN_REVIEW = {
    kind: {{ kind | tojson }},
    status: {{ status | tojson }},
    total: {{ total }},
    loaded: {{ items|length }},
    pageSize: {{ page_size }},
    view: {{ view | tojson }},
  };
</script>
<script src="/static/js/review.js?v={{ version }}"></script>
{% endblock %}
