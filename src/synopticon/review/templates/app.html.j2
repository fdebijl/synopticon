{% macro hidden_badge(cls='') -%}
<span class="hidden-badge {{ cls }}" title="Hidden on Synology Photos" aria-label="Person hidden on Synology Photos">
  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
    <line x1="1" y1="1" x2="23" y2="23"/>
  </svg>
</span>
{%- endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Synopticon review</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: system-ui, sans-serif; margin: 0; padding: 1rem;
         background: #fafafa; color: #1a1a1a; }
  @media (prefers-color-scheme: dark) {
    body { background: #16181c; color: #e6e6e6; }
    .card, .bar { background: #22252b !important; border-color: #333 !important; }
  }
  .bar { position: sticky; top: 0; background: #fff; border: 1px solid #ddd;
         padding: .5rem; border-radius: 8px; display: flex; gap: .5rem;
         flex-wrap: wrap; align-items: center; margin-bottom: 1rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(240px,1fr));
          gap: .75rem; }
  .card { background: #fff; border: 1px solid #ddd; border-radius: 8px;
          padding: .6rem; font-size: .85rem; }
  .card.sel { outline: 3px solid #3b82f6; }
  .card img { width: 96px; height: 96px; object-fit: cover; border-radius: 6px; }
  .thumbs img { width: 48px; height: 48px; margin: 2px; border-radius: 4px;
                object-fit: cover; }
  .merge { display: flex; align-items: center; gap: .4rem; }
  .merge-side { flex: 1; min-width: 0; }
  .merge-side .thumbs { display: flex; flex-wrap: wrap; }
  .merge-arrow { flex: 0 0 auto; opacity: .6; }
  button { cursor: pointer; }
  .muted { opacity: .6; font-size: .75rem; }
  .thumb-group { position: relative; display: inline-block; }
  .hidden-badge { display: inline-flex; align-items: center; line-height: 0;
                  color: #fff; background: rgba(0,0,0,.62); border-radius: 999px;
                  padding: 2px; }
  .thumb-group > .hidden-badge { position: absolute; top: 3px; right: 3px; z-index: 1; }
  .name-hidden { margin-left: .3rem; vertical-align: middle; opacity: .85; }
  body.hide-unnamed .card[data-unnamed-target] { display: none; }
  body.hide-unnamed-merges .card[data-unnamed-merge] { display: none; }
  .card[data-named-merge] { border-color: #dc2626; box-shadow: 0 0 0 1px #dc2626 inset; }
  .danger-banner { background: #dc2626; color: #fff; font-weight: 600;
                   font-size: .72rem; padding: .25rem .4rem; border-radius: 6px;
                   margin-bottom: .4rem; }
</style>
</head>
<body>
<div class="bar">
  <strong>Synopticon review</strong>
  <span class="muted">y = approve · n = reject · s = skip</span>
  <span style="flex:1"></span>
  <form method="get" style="display:flex;gap:.4rem;">
    <select name="kind">
      {% for k in ['', 'assign', 'low_confidence', 'reassign', 'merge', 'merge_named', 'new_person'] %}
      <option value="{{ k }}" {% if k==kind %}selected{% endif %}>{{ k or 'all kinds' }}</option>
      {% endfor %}
    </select>
    <select name="status">
      {% for s in ['pending','approved','rejected','applied'] %}
      <option value="{{ s }}" {% if s==status %}selected{% endif %}>{{ s }}</option>
      {% endfor %}
    </select>
    <button type="submit">filter</button>
  </form>
  <button onclick="bulk()">approve all {{ kind or 'assign' }} &ge; conf</button>
  <input id="bulkconf" type="number" step="0.01" value="0.55" style="width:5rem">
  <label class="muted" style="display:flex;align-items:center;gap:.25rem;">
    <input type="checkbox" id="hideUnnamed" onchange="toggleUnnamed()">
    hide reassigns to unnamed
  </label>
  <label class="muted" style="display:flex;align-items:center;gap:.25rem;">
    <input type="checkbox" id="hideUnnamedMerges" onchange="toggleUnnamedMerges()">
    hide merges between unnamed
  </label>
</div>

<div class="grid" id="grid">
{% for it in items %}
  <div class="card" data-id="{{ it.item_id }}"{% if it.unnamed_target %} data-unnamed-target="1"{% endif %}{% if it.unnamed_merge %} data-unnamed-merge="1"{% endif %}{% if it.named_merge %} data-named-merge="1"{% endif %} tabindex="0">
    {% if it.crop and it.kind != 'reassign' %}
      {% if it.item_url %}<a href="{{ it.item_url }}" target="_blank" rel="noopener" title="open photo in Synology Photos"><img src="{{ it.crop }}" alt=""></a>
      {% else %}<img src="{{ it.crop }}" alt="">{% endif %}
    {% endif %}
    {% if it.kind == 'new_person' %}
      <div class="thumbs">{% for c in it.new_person_crops %}{% if c %}<img src="{{ c }}">{% endif %}{% endfor %}</div>
      <input placeholder="suggested name" value="{{ it.payload.suggested_name or '' }}"
             onchange="setName({{ it.item_id }}, this.value)">
    {% elif it.kind in ('merge', 'merge_named') %}
      {% if it.named_merge %}
      <div class="danger-banner" title="Both people are already named — merging is irreversible and destroys a human label">
        &#9888; named &harr; named — irreversible, destroys a human label
      </div>
      {% endif %}
      <div class="merge">
        <div class="merge-side">
          <div><strong>
            {% if it.person_a_url %}<a href="{{ it.person_a_url }}" target="_blank" rel="noopener">{{ it.payload.person_a.name or it.payload.person_a.person_id }}</a>
            {% else %}{{ it.payload.person_a.name or it.payload.person_a.person_id }}{% endif %}
          </strong></div>
          <div class="thumb-group">{% if it.person_a_hidden %}{{ hidden_badge() }}{% endif %}<div class="thumbs">{% for c in it.merge_crops_a %}{% if c %}<img src="{{ c }}">{% endif %}{% endfor %}</div></div>
        </div>
        <div class="merge-arrow">&harr;</div>
        <div class="merge-side">
          <div><strong>
            {% if it.person_b_url %}<a href="{{ it.person_b_url }}" target="_blank" rel="noopener">{{ it.payload.person_b.name or it.payload.person_b.person_id }}</a>
            {% else %}{{ it.payload.person_b.name or it.payload.person_b.person_id }}{% endif %}
          </strong></div>
          <div class="thumb-group">{% if it.person_b_hidden %}{{ hidden_badge() }}{% endif %}<div class="thumbs">{% for c in it.merge_crops_b %}{% if c %}<img src="{{ c }}">{% endif %}{% endfor %}</div></div>
        </div>
      </div>
    {% elif it.kind == 'reassign' %}
      <div class="merge">
        <div class="merge-side">
          <div><strong>
            {% if it.from_person_url %}<a href="{{ it.from_person_url }}" target="_blank" rel="noopener">{{ it.payload.from_person_name or it.payload.from_person_id }}</a>
            {% else %}{{ it.payload.from_person_name or it.payload.from_person_id }}{% endif %}
          </strong></div>
          {% if it.crop %}
            {% if it.item_url %}<a href="{{ it.item_url }}" target="_blank" rel="noopener" title="open photo in Synology Photos"><img src="{{ it.crop }}" alt=""></a>
            {% else %}<img src="{{ it.crop }}" alt="">{% endif %}
          {% endif %}
        </div>
        <div class="merge-arrow">&rarr;</div>
        <div class="merge-side">
          <div><strong>
            {% if it.person_url %}<a href="{{ it.person_url }}" target="_blank" rel="noopener">{{ it.payload.person_name or it.payload.person_id }}</a>
            {% else %}{{ it.payload.person_name or it.payload.person_id }}{% endif %}
          </strong></div>
          <div class="thumb-group">{% if it.target_hidden %}{{ hidden_badge() }}{% endif %}<div class="thumbs">{% for c in it.target_crops %}<img src="{{ c }}">{% endfor %}</div></div>
        </div>
      </div>
      <div class="muted">to-sim {{ '%.3f'|format(it.confidence or 0) }}{% if it.payload.from_similarity is not none %} · from-sim {{ '%.3f'|format(it.payload.from_similarity) }}{% endif %}</div>
    {% else %}
      <div><strong>{{ it.payload.person_name or it.payload.person_id }}</strong>{% if it.target_hidden %}{{ hidden_badge('name-hidden') }}{% endif %}</div>
      <div class="muted">conf {{ '%.3f'|format(it.confidence or 0) }}</div>
    {% endif %}
    <div class="muted">{{ it.kind }} · {{ it.status }}</div>
    <div>
      <button onclick="decide({{ it.item_id }}, 'approve')">✓ (y)</button>
      <button onclick="decide({{ it.item_id }}, 'reject')">✗ (n)</button>
    </div>
  </div>
{% endfor %}
</div>

<script>
function post(url, data) {
  const body = new URLSearchParams(data);
  return fetch(url, {method: 'POST', body});
}
function decide(id, decision) {
  post('/decide/' + id, {decision}).then(() => {
    const el = document.querySelector('.card[data-id="' + id + '"]');
    if (el) { el.style.opacity = 0.35; }
    focusNext();
  });
}
function setName(id, name) { post('/name/' + id, {suggested_name: name}); }
function bulk() {
  const kind = "{{ kind or 'assign' }}";
  const c = document.getElementById('bulkconf').value;
  post('/bulk', {kind, min_confidence: c}).then(() => location.reload());
}
function toggleUnnamed() {
  const on = document.getElementById('hideUnnamed').checked;
  document.body.classList.toggle('hide-unnamed', on);
  localStorage.setItem('hideUnnamed', on ? '1' : '');
  select(0);
}
if (localStorage.getItem('hideUnnamed')) {
  document.getElementById('hideUnnamed').checked = true;
  document.body.classList.add('hide-unnamed');
}
function toggleUnnamedMerges() {
  const on = document.getElementById('hideUnnamedMerges').checked;
  document.body.classList.toggle('hide-unnamed-merges', on);
  localStorage.setItem('hideUnnamedMerges', on ? '1' : '');
  select(0);
}
if (localStorage.getItem('hideUnnamedMerges')) {
  document.getElementById('hideUnnamedMerges').checked = true;
  document.body.classList.add('hide-unnamed-merges');
}
let idx = 0;
const cards = () => Array.from(document.querySelectorAll('.card'))
  .filter(c => c.offsetParent !== null);
function select(i) {
  cards().forEach(c => c.classList.remove('sel'));
  const cs = cards();
  if (!cs.length) return;
  idx = Math.max(0, Math.min(i, cs.length - 1));
  cs[idx].classList.add('sel');
  cs[idx].scrollIntoView({block: 'nearest'});
}
function focusNext() { select(idx + 1); }
document.addEventListener('keydown', e => {
  const cs = cards();
  if (!cs.length) return;
  const id = cs[idx].dataset.id;
  if (e.key === 'y') decide(id, 'approve');
  else if (e.key === 'n') decide(id, 'reject');
  else if (e.key === 's') focusNext();
  else if (e.key === 'j') select(idx + 1);
  else if (e.key === 'k') select(idx - 1);
});
select(0);
</script>
</body>
</html>
